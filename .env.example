# Published host ports — these are loopback-only (nginx is the public entry
# point, see setup.sh); change them only if they conflict with something else
# already running on the server.
FRONTEND_PORT=3001
BACKEND_PORT=3000

# Public domain, filled in interactively by setup.sh on first run. Leave empty
# to serve the CRM off the server's bare IP instead — setup.sh only requests a
# TLS certificate when this is set (Let's Encrypt can't issue for a bare IP).
DOMAIN=

# The CRM's real public origin (protocol + domain/IP, no port — nginx listens
# on the standard 80/443 and splits by path, `/` → frontend, `/api` → backend).
# setup.sh sets this for you and upgrades it from http to https automatically
# once a certificate exists — do not need to hand-edit this normally.
CORS_ORIGIN=http://localhost:3001

# Database connection parameters
DB_HOST=db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_NAME=adsicrm_database

# Database adminer port (SSH tunnel only — Adminer's own port is loopback-bound,
# never exposed to the internet; not linked from the CRM UI)
ADMINER_PORT=8978

# JWT Secrets
JWT_ACCESS_SECRET=CHANGE_ME_JWT_ACCESS
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH

# JWT Expiration times
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis connection parameters
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Docker socket proxy (Settings → Monitoring per-container stats). Internal
# compose network only — do not publish this port to the host.
DOCKER_PROXY_HOST=docker-socket-proxy
DOCKER_PROXY_PORT=2375

# Self-update daemon (host-level Python process installed by setup.sh — see
# updater/daemon.py). host.docker.internal is how a container reaches a
# host-bound port (see docker-compose.yml's extra_hosts on the backend
# service); the daemon itself binds 127.0.0.1 only, never the internet.
# UPDATER_TOKEN is generated by setup.sh, same as the JWT/DB secrets above.
UPDATER_HOST=host.docker.internal
UPDATER_PORT=8765
UPDATER_TOKEN=CHANGE_ME_UPDATER_TOKEN
